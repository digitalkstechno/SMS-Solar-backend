  <script>
    /* SMS Enterprise approved variable product catalogue (Dynamic from Backend) */
    <% 
      const getOptionsHTML = (key, defaultOptions) => {
        if (!quotationOptions || quotationOptions.length === 0) return defaultOptions;
        const options = quotationOptions.filter(o => o.key === key);
        if (options.length === 0) return defaultOptions;
        return options.map(o => `<option value="${o.value}">${o.label}</option>`).join('');
      };
    %>
    
    $('module').innerHTML = `<%- getOptionsHTML('module', '<option value="Adani | N-Type TOPCon Bifacial | 540">Adani · N-Type TOPCon Bifacial · 540 W</option><option value="Waaree | N-Type TOPCon Bifacial | 550">Waaree · N-Type TOPCon Bifacial · 550 W</option><option value="Pahal | Mono PERC Half-Cut | 540">Pahal · Mono PERC Half-Cut · 540 W</option><option value="Goldi | N-Type TOPCon | 550">Goldi · N-Type TOPCon · 550 W</option><option value="Rayzon | N-Type TOPCon Bifacial | 575">Rayzon · N-Type TOPCon Bifacial · 575 W</option>') %>`;
    $('inverter').innerHTML = `<%- getOptionsHTML('inverter', '<option>Velox · On-Grid Inverter</option><option>Solaryaan · On-Grid Inverter</option>') %>`;
    $('structure').innerHTML = `<%- getOptionsHTML('structure', '<option>Hindustaar Solar Mounting Structure</option>') %>`;
    $('dcdb').innerHTML = `<%- getOptionsHTML('dcdb', '<option>Simens DCDB with Type II SPD</option>') %>`;
    $('acdb').innerHTML = `<%- getOptionsHTML('acdb', '<option>Simens ACDB with Type II SPD</option>') %>`;
    $('roof').closest('.field').insertAdjacentHTML('beforebegin', '<div class="field"><label>Solar cable product</label><select id="cables">' + `<%- getOptionsHTML('cables', '<option>Polycab Solar DC Cable & AC Cable</option>') %>` + '</select></div>');
    pages[4].querySelector('tbody').insertAdjacentHTML('beforeend', '<tr><td><b>Solar cables</b></td><td data-cables></td><td>UV-resistant solar DC / AC cable</td></tr>');
    function refreshProducts() { const moduleParts = $('module').value.split(' | '); $('watt').value = moduleParts.length > 2 ? moduleParts[2] : ($('watt').value || 1); calc(); set('[data-module]', moduleParts.length > 2 ? moduleParts[0] + ' · ' + moduleParts[1] + ' · ' + moduleParts[2] + ' W' : $('module').value); set('[data-inverter]', $('inverter').value); set('[data-structure]', $('structure').value); set('[data-dcdb]', $('dcdb').value); set('[data-acdb]', $('acdb').value); set('[data-cables]', $('cables').value) }
    ['module', 'inverter', 'structure', 'dcdb', 'acdb', 'cables'].forEach(id => { if($(id)) $(id).addEventListener('change', refreshProducts); });
    refreshProducts();
  </script>
