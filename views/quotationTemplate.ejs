<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>SMS Enterprise | Live Solar Quotation</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

    :root {
      --p: #A63C71;
      --p2: #c1558c;
      --ink: #1c1620;
      --mut: #766d7b;
      --paper: #fff;
      --soft: #fdf5f9;
      --line: #f0dae6;
      --green: #15865e;
      --blue: #1976c9
    }

    * {
      box-sizing: border-box
    }

    body {
      margin: 0;
      background: #e9e3ec;
      color: var(--ink);
      font: 14px 'DM Sans', sans-serif
    }

    .app {
      display: grid;
      grid-template-columns: 310px 1fr;
      min-height: 100vh
    }

    .editor {
      background: #22162c;
      color: #fff;
      padding: 23px 19px;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: auto
    }

    .brand {
      font-size: 15px;
      letter-spacing: .15em;
      font-weight: 700
    }

    .brand small {
      display: block;
      color: #cfc1d7;
      font-size: 10px;
      letter-spacing: .09em;
      margin-top: 4px
    }

    .editor h2 {
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: #d5bbdf;
      margin: 25px 0 10px
    }

    .field {
      margin: 0 0 10px
    }

    .field label {
      display: block;
      font-size: 10px;
      color: #e3d9e7;
      margin-bottom: 5px
    }

    .field input,
    .field select {
      width: 100%;
      padding: 9px;
      border: 1px solid #4c3e58;
      border-radius: 7px;
      background: #2d2038;
      color: #fff;
      font: 13px 'DM Sans'
    }

    .grid2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px
    }

    .actions {
      display: flex;
      gap: 8px;
      margin-top: 13px
    }

    .actions button {
      border: 0;
      border-radius: 7px;
      padding: 10px 9px;
      font-weight: 700;
      cursor: pointer;
      flex: 1
    }

    .print {
      background: #fff;
      color: var(--p)
    }

    .reset {
      background: #463553;
      color: #fff
    }

    .workspace {
      padding: 26px
    }

    .toolbar {
      max-width: 900px;
      margin: 0 auto 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--mut);
      font-size: 12px
    }

    .pages {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
      justify-content: flex-end
    }

    .pages button {
      border: 1px solid #d8cbdf;
      background: #fff;
      color: #5e4e68;
      border-radius: 50%;
      width: 27px;
      height: 27px;
      font-size: 11px;
      cursor: pointer
    }

    .pages button.active {
      background: var(--p);
      border-color: var(--p);
      color: #fff
    }

    .book {
      width: min(100%, 850px);
      margin: auto
    }

    .page {
      display: none;
      background: var(--paper);
      min-height: 900px;
      position: relative;
      padding: 85px 35px 40px;
      box-shadow: 0 8px 35px #3a244536
    }

    .page:not(.cover)::before {
      content: "";
      position: absolute;
      top: 20px;
      left: 20px;
      width: 140px;
      height: 40px;
      background-image: url('<%= basePath %>/pdfs/sms.png');
      background-size: contain;
      background-repeat: no-repeat;
      background-position: left center;
    }

    @media print {
      .page:not(.cover)::before {
        top: 20px;
        left: 15px;
      }
      .page {
        display: flex !important;
        flex-direction: column;
        justify-content: center;
        padding: 85px 23px 60px;
      }
    }

    .page.active {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .cover {
      padding: 0;
      overflow: hidden
    }

    .coverHero {
      height: 400px;
      padding: 30px 40px;
      color: #fff;
      background: linear-gradient(120deg, #4a1a33, #A63C71 58%, #c1558c);
      position: relative
    }

    .coverHero:after {
      display: none;
    }

    .coverHero>* {
      position: relative;
      z-index: 1
    }

    .logo {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: .16em
    }

    .logo small {
      display: block;
      font-size: 9px;
      letter-spacing: .08em;
      font-weight: 400;
      margin-top: 4px
    }

    .eyebrow {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .16em;
      margin-top: 102px;
      opacity: .82
    }

    .cover h1 {
      font: 700 43px/1.1 'Times New Roman', Times, serif;
      max-width: 500px;
      margin: 11px 0
    }

    .coverSub {
      font-size: 15px
    }

    .coverInfo {
      padding: 30px 40px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px
    }

    .coverInfo h2 {
      font: 600 28px 'Times New Roman', Times, serif;
      margin: 6px 0
    }

    .meta {
      text-align: right;
      color: var(--mut);
      line-height: 1.85
    }

    .meta b {
      color: var(--ink)
    }

    h1,
    h2,
    h3 {
      font-family: 'Times New Roman', Times, serif
    }

    h2 {
      font-size: 24px;
      margin: 4px 0 10px
    }

    h3 {
      font-size: 16px;
      margin: 0 0 10px
    }

    .kicker {
      color: var(--p);
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: .15em;
      font-weight: 700
    }

    .lead {
      color: var(--mut);
      line-height: 1.7;
      max-width: 600px
    }

    .kpis {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 20px 0
    }

    .kpi {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 13px
    }

    .kpi small {
      display: block;
      color: var(--mut);
      text-transform: uppercase;
      letter-spacing: .06em;
      font-size: 9px
    }

    .kpi b {
      font-size: 21px;
      display: block;
      margin-top: 5px
    }

    .green b {
      color: var(--green)
    }

    .blue b {
      color: var(--blue)
    }

    .purple b {
      color: var(--p)
    }

    .panel {
      background: var(--soft);
      border-radius: 13px;
      padding: 18px
    }

    .twocol {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 17px
    }

    .offer {
      background: var(--soft);
      border-radius: 13px;
      padding: 14px
    }

    .row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 9px 0;
      border-bottom: 1px solid #e3dbe7;
      font-size: 12px
    }

    .row:last-child {
      border: 0
    }

    .row b {
      color: var(--p);
      text-align: right
    }

    .pay {
      background: var(--p);
      color: #fff;
      border-radius: 13px;
      padding: 22px;
      box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .pay small {
      opacity: .8;
      text-transform: uppercase;
      letter-spacing: .1em
    }

    .pay b {
      display: block;
      font-size: 31px;
      margin: 7px 0
    }

    .pay p {
      margin: 0;
      font-size: 12px;
      opacity: .85
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px
    }

    .card {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px;
      background: #fff;
    }

    .card .icon {
      font-size: 20px;
      color: var(--p)
    }

    .card b {
      display: block;
      margin: 7px 0 4px
    }

    .card p {
      font-size: 11px;
      color: var(--mut);
      line-height: 1.5;
      margin: 0
    }

    .steps {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 6px;
      margin-top: 20px
    }

    .step {
      display: flex;
      align-items: center;
      gap: 3px;
      font-size: 10px;
      color: var(--ink);
      font-weight: 700;
      white-space: nowrap
    }

    .step:not(:last-child):after {
      content: '→';
      margin-left: 6px;
      color: var(--p);
      font-size: 12px
    }

    .num {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--soft);
      color: var(--p);
      font-weight: 700;
      margin: 0;
      font-size: 9.5px
    }

    .bars {
      display: flex;
      align-items: end;
      gap: 17px;
      height: 120px;
      padding: 20px 15px 10px;
    }

    .bar {
      flex: 1;
      min-height: 8px;
      background: linear-gradient(#c1558c, var(--p));
      border-radius: 6px 6px 0 0;
      position: relative
    }

    .bar:before {
      content: attr(data-v);
      position: absolute;
      top: -18px;
      width: 100%;
      text-align: center;
      font-size: 10px;
      color: var(--p);
      font-weight: 700
    }

    .bar:after {
      content: attr(data-l);
      position: absolute;
      bottom: -20px;
      width: 100%;
      text-align: center;
      font-size: 10px;
      color: var(--mut)
    }

    .table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      font-size: 12px
    }

    .table th {
      text-align: left;
      background: var(--soft);
      color: var(--p);
      padding: 10px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .06em
    }

    .table td {
      padding: 10px;
      border-bottom: 1px solid var(--line);
      color: var(--mut)
    }

    .table td b {
      color: var(--ink)
    }

    .check {
      color: var(--green);
      font-weight: 700
    }

    .quote {
      font: 600 18px/1.5 'Times New Roman', Times, serif;
      color: var(--p);
      padding: 15px;
      border-left: 4px solid var(--p2);
      background: var(--soft);
      margin: 15px 0
    }

    .qr {
      width: 130px;
      height: 130px;
      border: 1px dashed #a683b7;
      display: grid;
      place-items: center;
      color: var(--p);
      font-size: 11px;
      text-align: center;
      background: repeating-linear-gradient(45deg, #f8f3fa, #f8f3fa 5px, #fff 5px, #fff 10px)
    }

    .signature {
      margin-top: 100px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 65px
    }

    .sign {
      border-top: 1px solid var(--ink);
      padding-top: 8px;
      font-size: 11px;
      color: var(--mut)
    }

    .footer {
      position: absolute;
      bottom: 15px;
      left: 35px;
      right: 35px;
      border-top: 1px solid var(--line);
      padding-top: 10px;
      display: flex;
      justify-content: space-between;
      color: var(--mut);
      font-size: 10px
    }

    .footer b {
      color: var(--p)
    }

    .accept {
      min-height: 850px
    }

    .thanks {
      background: linear-gradient(145deg, #4a1a33, #A63C71);
      color: #fff;
      padding: 80px 52px
    }

    .thanks h1 {
      font-size: 48px;
      margin: 140px 0 15px
    }

    .thanks .contact {
      margin-top: 60px;
      line-height: 2;
      color: #e6d6ed
    }

    .brand-category {
      margin-top: 25px;
    }

    .brand-category h3 {
      font-family: 'Times New Roman', Times, serif;
      font-size: 16px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 5px;
      margin-bottom: 12px;
      color: var(--ink);
    }

    .brand-boxes {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .brand-box {
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 8px 12px;
      text-align: center;
      min-width: 100px;
      background: #fff;
    }

    .brand-box b {
      display: block;
      font-size: 12px;
      text-transform: uppercase;
    }

    .brand-box small {
      font-size: 9px;
      color: var(--mut);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      font-size: 12px;
    }

    .spec-table th,
    .spec-table td {
      border: 1px solid var(--line);
      padding: 18px 15px;
      vertical-align: middle;
    }

    .spec-table th {
      background: var(--soft);
      color: var(--p);
      text-transform: uppercase;
      font-size: 10px;
      letter-spacing: 0.05em;
    }

    .spec-table .img-col {
      width: 100px;
      text-align: center;
    }

    .spec-table .img-placeholder {
      width: 60px;
      height: 40px;
      background: #f5f0f7;
      border-radius: 4px;
      display: inline-block;
    }

    .spec-table .title-col {
      width: 180px;
      font-weight: 700;
      font-size: 13px;
      color: var(--ink);
      text-transform: uppercase;
    }

    .spec-table .desc-col {
      color: var(--mut);
      line-height: 1.6;
    }

    .spec-table .desc-col b {
      color: var(--ink);
      font-weight: 600;
      font-size: 13px;
    }

    @media(max-width:800px) {
      .app {
        display: block
      }

      .editor {
        position: relative;
        height: auto
      }

      .workspace {
        padding: 10px
      }

      .page {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 85px 23px 60px;
        min-height: 950px
      }

      .coverHero {
        padding: 34px 25px
      }

      .coverInfo {
        padding: 28px 25px
      }

      .footer {
        left: 23px;
        right: 23px
      }

      .kpis,
      .cards {
        grid-template-columns: repeat(2, 1fr)
      }

      .meta {
        text-align: left
      }
    }

    @media print {
      body {
        background: #fff
      }

      .editor,
      .toolbar {
        display: none !important
      }

      .workspace {
        padding: 0 !important
      }

      .book {
        width: 100% !important
      }

      .page,
      .page.active {
        display: block !important;
        box-shadow: none !important;
        min-height: 290mm !important;
        height: auto !important;
        margin: 0 !important;
        padding: 40px 40px !important;
        border: none !important;
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        position: relative !important
      }

      .page.cover,
      .page.cover.active {
        min-height: 980px !important;
        padding: 0 !important;
        page-break-after: always !important;
        break-after: page !important
      }

      .page.thanks,
      .page.thanks.active {
        min-height: 980px !important;
        padding: 80px 40px !important;
        page-break-before: always !important;
        break-before: page !important
      }

      .coverHero {
        padding: 50px 40px !important
      }

      .coverInfo {
        padding: 40px 40px !important
      }

      .footer {
        left: 40px !important;
        right: 40px !important;
        display: flex !important;
        bottom: 20px !important
      }

      h1,
      h2,
      h3,
      .kicker {
        page-break-after: avoid !important;
        break-after: avoid !important
      }

      .panel,
      .offer,
      .cards,
      .kpis,
      .steps,
      .table,
      .quote,
      .signature,
      .twocol,
      .kpi,
      .card,
      .row,
      .bars {
        page-break-inside: avoid !important;
        break-inside: avoid !important
      }

      @page {
        size: A4;
        margin: 0
      }
    }

    .page.accept-thanks,
    .page.accept-thanks.active {
      padding: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      min-height: 980px !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important
    }

    .accept-half {
      padding: 40px;
      flex: 1.45;
      position: relative
    }

    .thanks-half {
      background: linear-gradient(145deg, #4a1a33, #A63C71);
      color: #fff;
      padding: 40px;
      flex: 0.55;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center
    }
    }
  </style>
</head>

<body>
  <div class="app">
    <main class="workspace">
      <div id="injectedData" style="display:none;">
        <input id="size"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('size'))?.values[0] || 0 %>" />
        <input id="watt"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('module w'))?.values[0] || 0 %>" />
        <input id="rate"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('rate'))?.values[0] || 0 %>" />
        <input id="gross"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('gross'))?.values[0] || 0 %>" />
        <input id="subsidy"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('subsidy'))?.values[0] || 0 %>" />
        <input id="loan"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('loan'))?.values[0] || 0 %>" />
        <input id="bill"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('bill'))?.values[0] || 0 %>" />
        <input id="name" value="<%= lead.fullName || 'Customer' %>" />
        <input id="proposal" value="<%= lead.leadrefrance || 'N/A' %>" />
        <input id="exec" value="<%= lead.assignName || lead.assignedTo?.fullName || 'Sales Executive' %>" />
        <input id="module" value="<%= quotation.solarModule %>" />
        <input id="inverter" value="<%= quotation.inverter %>" />
        <input id="structure"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('structure'))?.values[0] || '' %>" />
        <input id="dcdb"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('dc protection'))?.values[0] || '' %>" />
        <input id="acdb"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('ac protection'))?.values[0] || '' %>" />
        <input id="cable"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('cable'))?.values[0] || '' %>" />
        <input id="roof"
          value="<%= quotation.rows.find(r => (r.title||'').toLowerCase().includes('roof'))?.values[0] || 'Flat Roof' %>" />
      </div>
      <div class="toolbar"><span>Live CRM quotation · all calculations update instantly</span>
        <div class="pages" id="nav"></div>
      </div>
      <div class="book">
        <section class="page cover active"
          style="position:relative; background-color:#fff; padding:0; overflow:hidden; height:297mm !important; min-height:297mm !important;">
          <!-- Background Image with Gradient for Text Readability -->
          <div style="position:absolute; top:0; bottom:0; left:0; right:0; z-index:0;">
            <%
              let bannerImg = 'residentialbanner.jpg'; // default to residential
              let pTypeForBanner = (lead.projecttype || lead.projectType || '').toLowerCase();
              if (pTypeForBanner.includes('commercial')) {
                bannerImg = 'commercialbanner.png';
              } else if (pTypeForBanner.includes('industr')) {
                bannerImg = 'Industrialbanner.jpeg';
              }
            %>
            <img src="<%= basePath %>/pdfs/<%= bannerImg %>"
              style="width:100%; height:100%; object-fit:cover; object-position: center;" />
            <div
              style="position:absolute; top:0; left:0; width:100%; height:65%; background:linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 80%);">
            </div>
          </div>

          <!-- Bottom White Blob SVG -->
          <svg style="position:absolute; bottom:-2px; left:0; width:100%; height:45%; z-index:2; display:block;"
            preserveAspectRatio="none" viewBox="0 0 100 100">
            <path d="M0,20 Q50,-10 100,30 L100,105 L0,105 Z" fill="#ffffff" />
          </svg>

          <!-- Bottom Purple Blob SVG -->
          <svg style="position:absolute; bottom:-2px; left:0; width:100%; height:26%; z-index:3; display:block;"
            preserveAspectRatio="none" viewBox="0 0 100 100">
            <path d="M0,35 Q60,50 100,0 L100,105 L0,105 Z" fill="#822650" />
          </svg>

          <!-- Content Container -->
          <div
            style="position:absolute; top:0; bottom:0; left:0; right:0; z-index:10; display:flex; flex-direction:column; padding:0;">
            <!-- TOP SECTION -->
            <div style="padding: 40px; color:#fff; width:70%; height:55%;">
              <div class="logo" style="margin-bottom:10px; margin-left:-20px;"><img src="<%= (typeof logoBase64 !== 'undefined' && logoBase64) ? 'data:image/png;base64,' + logoBase64 : basePath + '/pdfs/sms.png' %>"
                  alt="SMS ENTERPRISE" style="max-height: 100px;" /></div>
              <div style="font-size:12px; opacity:0.9; line-height:1.4;">Powering a<br />Sustainable Tomorrow</div>

              <div class="eyebrow"
                style="margin-top:55px; color:#e19fb9; font-weight:700; font-size:12px; letter-spacing:0.1em;">
                <%= (lead.projecttype || lead.projectType || 'COMMERCIAL').toUpperCase() %> OFFER</div>
              <%
                let targetWord = 'business';
                let pt = (lead.projecttype || lead.projectType) ? (lead.projecttype || lead.projectType).toLowerCase() : '';
                if (pt.includes('resident') || pt.includes('home')) targetWord = 'home';
                else if (pt.includes('industr')) targetWord = 'industry';
